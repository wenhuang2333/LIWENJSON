{
  "name": "liwenjson",
  "version": "1.5.2",
  "description": "The local execution gate for LLM output, as a Model Context Protocol server and a library, powered by the MoonBit engine.",
  "license": "Apache-2.0",
  "author": {
    "name": "LIWENJSON contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenhuang2333/LIWENJSON.git",
    "directory": "code/npm"
  },
  "homepage": "https://github.com/wenhuang2333/LIWENJSON#readme",
  "bugs": {
    "url": "https://github.com/wenhuang2333/LIWENJSON/issues"
  },
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "mcp.cjs",
    "vendor/liwenjson.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "json",
    "repair",
    "streaming",
    "llm",
    "tool-call",
    "mcp",
    "execution-gate",
    "moonbit"
  ],
  "bin": {
    "liwenjson-mcp": "./mcp.cjs"
  }
}
